// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Plan {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum Status {
  PENDING
  ACTIVE
  FROZEN
  CANCELED
}

enum PayMethod {
  BANK
  PAYPAL
  USDT
}

enum UsdtNet {
  TRC20
  ERC20
  BEP20
}

enum SubType {
  DISCORD
  TELEGRAM
}



// Utenti del bot
model User {
  id              Int             @id @default(autoincrement())
  telegramUserId  String          @unique                     
  telegramHandle  String?         @unique                      
  discordUserId   String?                                        
  phone           String?
  email           String?         @unique
  bitgetUid       String?

  payments        Payment[]
  subscriptions   Subscription[]
  invites         Invite[]        

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([email])
  @@index([telegramHandle])
}


model Payment {
  id              Int             @id @default(autoincrement())
  user            User            @relation(fields: [userId], references: [id])
  userId          Int

  method          PayMethod
  usdtNet         UsdtNet?
  proofFileId     String?                                
  payFrom         String?                                 
  payTo           String?                                      
  amount          Float
  amountCurrency  String                                        
  paidAt          DateTime

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, paidAt])
}

// Sottoscrizioni (Discord/Telegram)
model Subscription {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id])
  userId    Int

  type      SubType   // "DISCORD" o "TELEGRAM"
  plan      Plan
  status    Status    @default(ACTIVE)

  startAt   DateTime
  endAt     DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, type, endAt])
}

// Inviti Discord generati (opzionale, utile se vuoi tracciare inviti univoci)
model Invite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  code      String   @unique
  url       String

  createdAt DateTime @default(now())
}


model EarlyAccess {
  id          Int     @id @default(autoincrement())
  telegram_id String  @unique @map("telegram_id")
  nome        String? @map("nome")
  importo     Float?  @map("importo")

  @@map("earlyaccess")
}




