// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Plan {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum Status {
  PENDING
  ACTIVE
  FROZEN
}

enum PayMethod {
  BANK
  PAYPAL
  USDT
}

enum UsdtNet {
  TRC20
  ERC20
  BEP20
}

// Modelli
model User {
  id              Int       @id @default(autoincrement())
  telegramUserId  String    @unique
  telegramHandle  String?   @unique
  discordUserId   String?
  phone           String?
  email           String?
  bitgetUid       String?
  earlyAccess     EarlyAccess? @relation(fields: [earlyAccessId], references: [id])
  earlyAccessId   Int?

  payments        Payment[]
  subscriptions   Subscription[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model EarlyAccess {
  id        Int     @id @default(autoincrement())
  phone     String?
  email     String?
  telegram  String?
  tier      String? // EA1, EA2
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id             Int       @id @default(autoincrement())
  user           User      @relation(fields: [userId], references: [id])
  userId         Int
  method         PayMethod
  usdtNet        UsdtNet?
  proofFileId    String?   // file Telegram
  payFrom        String?
  payTo          String?
  amount         Float
  amountCurrency String
  paidAt         DateTime

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Subscription {
  id             Int      @id @default(autoincrement())
  user           User     @relation(fields: [userId], references: [id])
  userId         Int
  type           String   // telegram / discord
  plan           Plan
  status         Status   @default(PENDING)
  startAt        DateTime
  endAt          DateTime

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
