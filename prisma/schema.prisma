generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYPAL
  USDT_TRANSFER
}

model Intake {
  id               Int            @id @default(autoincrement())
  telegramUserId   String?        // id numerico telegram come stringa
  telegramNick     String
  discordNick      String
  bitgetUID        String
  email            String
  phoneCountryCode String         // es. +39
  phoneNumber      String         // es. 3331234567
  plan             Plan
  payment          PaymentMethod
  createdAt        DateTime       @default(now())

  @@index([email])
  @@index([telegramNick])
  @@index([discordNick])
  @@index([bitgetUID])
}

model Invite {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String   @unique
  url       String
  createdAt DateTime @default(now())
}






