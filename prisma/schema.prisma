generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ===== ENUM ===== */
enum Plan {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum Status {
  PENDING
  ACTIVE
  FROZEN
}

enum PayMethod {
  BANK
  PAYPAL
  USDT
}

enum UsdtNet {
  TRC20
  ERC20
  BEP20
}

/* ===== MODELS ===== */

// Utenti della tua app
model User {
  id             Int       @id @default(autoincrement())
  telegramUserId String    @unique
  telegramHandle String?   @unique
  discordUserId  String?
  phone          String?
  email          String?   @unique
  bitgetUid      String?

  payments       Payment[]
  subscriptions  Subscription[]
  invites        Invite[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Tabella esistente earlyaccess(nome, telegram_id, importo)
// Manteniamo PK tecnica "id" e mettiamo UNIQUE su telegram_id per lookup veloce
model EarlyAccess {
  id          Int     @id @default(autoincrement())
  telegram_id String  @unique @map("telegram_id")
  nome        String? @map("nome")
  importo     Float?  @map("importo")

  @@map("earlyaccess")
}

// Pagamenti ricevuti (audit)
model Payment {
  id             Int       @id @default(autoincrement())
  user           User      @relation(fields: [userId], references: [id])
  userId         Int

  method         PayMethod
  usdtNet        UsdtNet?
  proofFileId    String?
  payFrom        String?
  payTo          String?
  amount         Float
  amountCurrency String
  paidAt         DateTime

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Sottoscrizioni (telegram/discord)
model Subscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  type      String   // "discord" o "telegram"
  plan      Plan
  status    Status   @default(PENDING)
  startAt   DateTime
  endAt     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Inviti Discord generati per utente
model Invite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  code      String   @unique
  url       String

  createdAt DateTime @default(now())
}



