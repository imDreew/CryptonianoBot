datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }

enum Plan      { MONTHLY QUARTERLY ANNUAL }
enum Status    { PENDING ACTIVE FROZEN }
enum PayMethod { BANK PAYPAL USDT }
enum UsdtNet   { TRC20 ERC20 BEP20 }
enum Target    { TELEGRAM DISCORD }
enum TgSub     { NONE LIFETIME SEMIANNUAL ANNUAL }

model Subscriber {
  id               String   @id @default(cuid())

  // Anagrafica
  phone            String
  telegramNick     String
  discordNick      String
  bitgetUid        String
  email            String   @unique
  verifyCode       String   @unique

  // Stato Discord
  discordPlan      Plan?
  discordStartDate DateTime?
  discordEndDate   DateTime?
  status           Status   @default(PENDING)
  discordUserId    String?  @db.VarChar(32)
  discordInviteCode String? // per tracciare quale invito è stato usato

  // Stato Telegram (solo CRM, niente auto-freeze qui)
  tgSub            TgSub    @default(NONE)
  telegramStartDate DateTime?
  telegramEndDate   DateTime?
  telegramUserId    String?  @db.VarChar(32)

  // Flag Early Access (da nick Telegram)
  isEarlyAccess    Boolean  @default(false)

  // Ultimo pagamento (snapshot)
  payMethod        PayMethod?
  usdtNetwork      UsdtNet?
  proofFileId      String?
  payFrom          String?
  payTo            String?
  amount           Float?
  amountCurrency   String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payments         Payment[]

  @@index([telegramUserId])
  @@index([discordUserId])
}

model Payment {
  id           String   @id @default(cuid())
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  target       Target
  method       PayMethod
  usdtNetwork  UsdtNet?
  fileId       String
  fileLink     String?
  rawText      String

  fromField    String?
  toField      String?
  amount       Float?
  currency     String?
  paidAt       DateTime?

  validDest    Boolean?
  validAmount  Boolean?
  expectedDest String?
  expectedAmt  Float?

  createdAt    DateTime @default(now())
}

