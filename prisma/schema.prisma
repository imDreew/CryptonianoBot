// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Plan      { MONTHLY QUARTERLY ANNUAL }
enum Status    { PENDING ACTIVE FROZEN }
enum PayMethod { BANK PAYPAL USDT }
enum UsdtNet   { TRC20 ERC20 BEP20 }
enum Target    { TELEGRAM DISCORD }
enum TgSub     { NONE LIFETIME SEMIANNUAL ANNUAL }

model EarlyAccess {
  id              String   @id @default(cuid())
  telegramHandle  String   @unique // senza @, lowercase
  phone           String?
  email           String?
  tier            String?  // EA1, EA2, ecc.
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

model Subscriber {
  id                 String   @id @default(cuid())

  phone              String
  telegramNick       String
  discordNick        String
  bitgetUid          String
  email              String   @unique
  verifyCode         String   @unique

  discordPlan        Plan?
  discordStartDate   DateTime?
  discordEndDate     DateTime?
  status             Status   @default(PENDING)
  discordUserId      String?  @db.VarChar(32)
  discordInviteCode  String?

  tgSub              TgSub    @default(NONE)
  telegramStartDate  DateTime?
  telegramEndDate    DateTime?
  telegramUserId     String?  @db.VarChar(32)

  isEarlyAccess      Boolean  @default(false)

  payMethod          PayMethod?
  usdtNetwork        UsdtNet?
  proofFileId        String?
  payFrom            String?
  payTo              String?
  amount             Float?
  amountCurrency     String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  payments           Payment[]

  @@index([telegramUserId])
  @@index([discordUserId])
}

model Payment {
  id           String     @id @default(cuid())
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  target       Target
  method       PayMethod
  usdtNetwork  UsdtNet?
  fileId       String
  fileLink     String?
  rawText      String

  fromField    String?
  toField      String?
  amount       Float?
  currency     String?
  paidAt       DateTime?

  validDest    Boolean?
  validAmount  Boolean?
  expectedDest String?
  expectedAmt  Float?

  createdAt    DateTime @default(now())
}

