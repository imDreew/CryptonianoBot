// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ========= ENUM ========= */

enum Plan {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum Status {
  PENDING
  ACTIVE
  FROZEN
  CANCELED
}

enum PayMethod {
  BANK
  PAYPAL
  USDT
}

enum UsdtNet {
  TRC20
  ERC20
  BEP20
}

enum SubType {
  DISCORD
  TELEGRAM
}

/* ========= MODELS ========= */

// Utenti del bot
model User {
  id              Int             @id @default(autoincrement())
  telegramUserId  String          @unique                      // chatId Telegram in stringa
  telegramHandle  String?         @unique                      // es. @username
  discordUserId   String?                                         // nel tuo index.js ci salvi il nickname Discord
  phone           String?
  email           String?         @unique
  bitgetUid       String?

  payments        Payment[]
  subscriptions   Subscription[]
  invites         Invite[]        // opzionale (se generi inviti Discord)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([email])
  @@index([telegramHandle])
}

// Pagamenti (audit)
model Payment {
  id              Int             @id @default(autoincrement())
  user            User            @relation(fields: [userId], references: [id])
  userId          Int

  method          PayMethod
  usdtNet         UsdtNet?
  proofFileId     String?                                       // file_id Telegram della ricevuta
  payFrom         String?                                       // IBAN/email/address mittente (se estratto)
  payTo           String?                                       // IBAN/email/address destinatario (se estratto)
  amount          Float
  amountCurrency  String                                         // "EUR" | "USDT"
  paidAt          DateTime

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, paidAt])
}

// Sottoscrizioni (Discord/Telegram)
model Subscription {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id])
  userId    Int

  type      SubType   // "DISCORD" o "TELEGRAM"
  plan      Plan
  status    Status    @default(ACTIVE)

  startAt   DateTime
  endAt     DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, type, endAt])
}

// Inviti Discord generati (opzionale, utile se vuoi tracciare inviti univoci)
model Invite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  code      String   @unique
  url       String

  createdAt DateTime @default(now())
}

/* ========= TABELLA ESISTENTE: earlyaccess =========
   Struttura assunta: public.earlyaccess (id PK, telegram_id UNIQUE, nome, importo)
   Se l'hai già popolata, lascia così. Prisma non la tocca se combacia.
*/
model EarlyAccess {
  id          Int     @id @default(autoincrement())
  telegram_id String  @unique @map("telegram_id")
  nome        String? @map("nome")
  importo     Float?  @map("importo")

  @@map("earlyaccess")
}




