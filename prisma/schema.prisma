generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ---------- ENUM ---------- */
enum Plan {
  MONTHLY
  QUARTERLY
  ANNUAL
}
enum Status {
  PENDING
  ACTIVE
  FROZEN
}
enum PayMethod {
  BANK
  PAYPAL
  USDT
}
enum UsdtNet {
  TRC20
  ERC20
  BEP20
}

/* ---------- MODELS ---------- */

/* Tabella utenti della tua app (nome a piacere) */
model User {
  id             Int       @id @default(autoincrement())
  telegramUserId String    @unique
  telegramHandle String?   @unique
  discordUserId  String?
  phone          String?
  email          String?
  bitgetUid      String?

  payments       Payment[]
  subscriptions  Subscription[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("users") // opzionale: cambia o rimuovi se la tabella si chiama già "User"
}

/* Mappa la TUA tabella già esistente: earlyaccess(nome, telegram_id, importo) */
model EarlyAccess {
  telegram_id String  @id @map("telegram_id")    // chiave primaria sulla colonna esistente
  nome        String? @map("nome")
  importo     Float?  @map("importo")           // se in DB è numeric/decimal puoi usare Decimal con @db.Decimal

  @@map("earlyaccess")                           // nome tabella reale
}

model Invite {
  id      Int    @id @default(autoincrement())
  userId  Int
  code    String
  url     String
  user    User   @relation(fields: [userId], references: [id])
}

/* Pagamenti */
model Payment {
  id             Int       @id @default(autoincrement())
  user           User      @relation(fields: [userId], references: [id])
  userId         Int

  method         PayMethod
  usdtNet        UsdtNet?
  proofFileId    String?
  payFrom        String?
  payTo          String?
  amount         Float
  amountCurrency String
  paidAt         DateTime

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("payments") // opzionale
}

/* Sottoscrizioni (telegram/discord) */
model Subscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  type      String   // "telegram" | "discord"
  plan      Plan
  status    Status   @default(PENDING)
  startAt   DateTime
  endAt     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions") // opzionale
}

