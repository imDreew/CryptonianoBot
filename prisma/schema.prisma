generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYPAL
  USDT_BEP20
  USDT_ERC20
  USDT_TRC20
}

model Intake {
  id               Int            @id @default(autoincrement())

  // Identità Telegram
  telegramUserId   String?        @unique
  telegramNick     String
  telegramNickNorm String         @unique

  // Identità Discord
  discordNick      String
  discordNickNorm  String         @unique

  // Exchange
  bitgetUID        String         @unique

  // Contatti
  email            String
  emailNorm        String         @unique
  phoneCountryCode String
  phoneNumber      String

  // Scelte
  plan             Plan
  payment          PaymentMethod

  createdAt        DateTime       @default(now())

  @@index([email])
  @@index([telegramNick])
  @@index([discordNick])
  @@index([bitgetUID])
  @@unique([phoneCountryCode, phoneNumber])
}

model Invite {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String   @unique
  url       String
  createdAt DateTime @default(now())
}





